# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: ElevenLabs API Key for NHL announcer voice audio.
ELEVENLABS_API_KEY=""

# ELEVENLABS_VOICE_ID: ElevenLabs voice identifier (default "6j98Cb2txyqvHRXeRQYZ").
ELEVENLABS_VOICE_ID="6j98Cb2txyqvHRXeRQYZ"

# CARTESIA_API_KEY: Primary Cartesia API Key for Sonic ultra-fast text-to-speech audio.
CARTESIA_API_KEY=""

# CARTESIA_VOICE_ID: Primary Cartesia voice identifier (default "a27f2ab7-6793-4893-9f40-e50d5e5605ba").
CARTESIA_VOICE_ID="a27f2ab7-6793-4893-9f40-e50d5e5605ba"

# CARTESIA_API_KEY_2: Second Cartesia account API Key (backup / automatic failover / second account).
# Also accepts CARTESIA_SECOND_API_KEY or CARTESIA_KEY_2.
CARTESIA_API_KEY_2=""

# CARTESIA_VOICE_ID_2: Second Cartesia account voice identifier (optional).
# Also accepts CARTESIA_SECOND_VOICE_ID.
CARTESIA_VOICE_ID_2=""

# SPEECHIFY_API_KEY: Speechify API Key from platform.speechify.ai.
# Also accepts SPEECHITY_API_KEY, SPEECHIFY_KEY, SPEECHIFY_SECRET_KEY, or SPEECHIFY_TOKEN.
SPEECHIFY_API_KEY=""

# SPEECHIFY_VOICE_ID: Speechify custom voice or cloned voice identifier.
# Also accepts SPEECHIFY_CUSTOM_VOICE_ID, SPEECHIFY_CLONED_VOICE_ID, SPEECHIFY_VOICE, or CUSTOM_VOICE_ID.
SPEECHIFY_VOICE_ID="cf2bbc5b-59fb-427e-95a5-bcd76641852f"

# SPEECHIFY_MODEL: Speechify TTS model (default "simba-3.2", also supports "simba-3.0").
SPEECHIFY_MODEL="simba-3.2"

